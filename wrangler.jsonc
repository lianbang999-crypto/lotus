{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lotus",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/agents/*",
      "/health"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "LotusAgent",
        "name": "LotusAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": [
        "LotusAgent"
      ],
      "tag": "v1"
    }
  ],
  "vars": {
    "WENCHAO_API_URL": "https://wenchao.foyue.org/api/retrieve",
    "MODEL_NAME": "deepseek-ai/DeepSeek-V3",
    "OPENAI_BASE_URL": "https://api.siliconflow.cn/v1"
  },
  // 必须挂在 foyue.org 子域下：auth.foyue.org 的会话 Cookie 域是 .foyue.org，
  // 上游 trustedOrigins 也只放行 https://*.foyue.org。换成 workers.dev 登录必然失败。
  "routes": [
    {
      "pattern": "lotus.foyue.org",
      "custom_domain": true
    }
  ]
}
